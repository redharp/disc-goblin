# Core
DISC_GOBLIN_PORT=8080
DISC_GOBLIN_LIBRARY_HOST_PATH=./library
DISC_GOBLIN_LIBRARY_ROOT=/media/library
DISC_GOBLIN_MOVIE_ROOT=/media/library/Movies
DISC_GOBLIN_TV_ROOT=/media/library/TV
DISC_GOBLIN_DATABASE_URL=postgresql+psycopg://disc_goblin:change-me@postgres:5432/disc_goblin
DISC_GOBLIN_POLL_INTERVAL=8
DISC_GOBLIN_AUTO_RIP=true
DISC_GOBLIN_EJECT_ON_SUCCESS=true
DISC_GOBLIN_MAX_CONCURRENT_RIPS=2

# Selection and publishing safety
DISC_GOBLIN_MIN_TITLE_SECONDS=1200
DISC_GOBLIN_AUTO_PUBLISH_CONFIDENCE=0.88
DISC_GOBLIN_RIP_MODE=smart

# Optional: TMDB v4 read access token. Without it, discs still rip immediately
# but wait for title/year confirmation before being published.
DISC_GOBLIN_TMDB_TOKEN=

# MakeMKV
DISC_GOBLIN_MAKEMKV_BIN=makemkvcon
DISC_GOBLIN_MAKEMKV_KEY=
DISC_GOBLIN_UDEV_DISCOVERY=true

# Firmware work is always off unless explicitly enabled. A matching signed-off
# manifest and payload must also be mounted under /config/firmware.
DISC_GOBLIN_FIRMWARE_AUDIT=true
DISC_GOBLIN_AUTO_FLASH=false
DISC_GOBLIN_FIRMWARE_MANIFEST=/config/firmware/manifest.yaml
DISC_GOBLIN_FIRMWARE_ROOT=/config/firmware
DISC_GOBLIN_SDF_PATH=/opt/makemkv/appdata/sdf.bin

# PostgreSQL container
POSTGRES_DB=disc_goblin
POSTGRES_USER=disc_goblin
POSTGRES_PASSWORD=change-me

# Set true to demo the full dashboard without optical hardware.
DISC_GOBLIN_SIMULATE=false
